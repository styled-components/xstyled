{
  "name": "@xstyled/emotion",
  "description": "A utility-first CSS-in-JS framework built for React (Emotion bindings).",
  "version": "3.8.3",
  "keywords": [
    "emotion",
    "css",
    "system",
    "styled-system",
    "tailwindcss"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "Greg Bergé <berge.greg@gmail.com>",
  "license": "MIT",
  "scripts": {
    "reset": "rm -rf dist",
    "build": "../../node_modules/.bin/rollup -c ../../build/rollup.config.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://xstyled.dev",
  "repository": "https://github.com/styled-components/xstyled/tree/main/packages/emotion",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/styled-components"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  },
  "dependencies": {
    "@xstyled/core": "workspace:^",
    "@xstyled/system": "workspace:^",
    "@xstyled/util": "workspace:^"
  }
}
