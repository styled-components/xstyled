{
  "include": [
    "src"
  ],
  "exclude": [
    "src/__type-tests__"
  ],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "target": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "jsx": "react",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@xstyled/util": [
        "../util/src"
      ],
      "@xstyled/prop-types": [
        "../prop-types/src"
      ],
      "@xstyled/system": [
        "../system/src"
      ],
      "@xstyled/core": [
        "../core/src"
      ]
    }
  }
}
