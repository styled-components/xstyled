{
  "name": "@xstyled/core",
  "description": "xstyled core utilities.",
  "version": "3.8.2",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "Greg Bergé <berge.greg@gmail.com>",
  "license": "MIT",
  "scripts": {
    "reset": "rm -rf dist",
    "build": "../../node_modules/.bin/rollup -c ../../build/rollup.config.js"
  },
  "homepage": "https://xstyled.dev",
  "repository": "https://github.com/styled-components/xstyled/tree/main/packages/core",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/styled-components"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xstyled/system": "workspace:^",
    "@xstyled/util": "workspace:^"
  }
}
